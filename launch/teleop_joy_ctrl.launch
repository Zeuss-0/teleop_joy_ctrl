<launch>
  <arg name="joy_topic" default="/joy_teleop/joy" />
  <arg name="cmd_vel_topic" default="/teleop_joy_ctrl/cmd_vel" />
  <arg name="config" default="$(find teleop_joy_ctrl)/config/default.yaml" />
  <arg name="twist_mux_config" default="$(find teleop_joy_ctrl)/config/twist_mux_takeover.yaml" />
  <arg name="robot_ip" default="192.168.1.80" />
  <arg name="robot_namespace" default="" />

  <arg name="start_arm_bringup" default="false" />
  <arg name="start_light_controller" default="true" />
  <!-- Same-process node is the default. Set legacy_single_node:=false for the two-node path. -->
  <arg name="legacy_single_node" default="false" />
  <arg name="start_takeover_mux" default="true" />
  <arg name="restore_system_teleop_on_shutdown" default="true" />
  <arg name="system_teleop_package" default="robot_driver" />
  <arg name="system_teleop_launch" default="teleop.launch" />
  <arg name="system_teleop_restore_delay" default="1.0" />
  <node if="$(arg start_takeover_mux)"
        pkg="twist_mux"
        type="twist_mux"
        name="twist_mux"
        output="screen">
    <rosparam command="load" file="$(arg twist_mux_config)" />
    <remap from="cmd_vel_out" to="/bulldog_velocity_controller/cmd_vel" />
  </node>
  <node if="$(arg restore_system_teleop_on_shutdown)"
        pkg="teleop_joy_ctrl"
        type="restore_system_teleop_on_shutdown.py"
        name="restore_system_teleop_on_shutdown"
        output="screen">
    <param name="enabled" value="$(arg restore_system_teleop_on_shutdown)" />
    <param name="package" value="$(arg system_teleop_package)" />
    <param name="launch_file" value="$(arg system_teleop_launch)" />
    <param name="delay" value="$(arg system_teleop_restore_delay)" />
  </node>
  <include if="$(arg start_arm_bringup)"
           file="$(find dobot_v4_bringup)/launch/bringup_v4.launch">
    <arg name="robotIp" value="$(arg robot_ip)" />
    <arg name="robotName" value="$(arg robot_namespace)" />
  </include>

  <group unless="$(arg legacy_single_node)">
    <node pkg="teleop_joy_ctrl"
          type="joy_intent_node.py"
          name="joy_intent_node"
          output="screen">
      <rosparam command="load" file="$(arg config)" />
      <param name="joy_topic" value="$(arg joy_topic)" />
    </node>

    <node pkg="teleop_joy_ctrl"
          type="teleop_executor_node.py"
          name="teleop_executor_node"
          output="screen">
      <rosparam command="load" file="$(arg config)" />
      <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)" />
      <param name="arm/robot_namespace" value="$(arg robot_namespace)" />
    </node>
  </group>

  <node if="$(arg legacy_single_node)"
        pkg="teleop_joy_ctrl"
        type="teleop_joy_ctrl_node.py"
        name="teleop_joy_ctrl_node"
        output="screen">
    <rosparam command="load" file="$(arg config)" />
    <param name="joy_topic" value="$(arg joy_topic)" />
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)" />
    <param name="arm/robot_namespace" value="$(arg robot_namespace)" />
  </node>

  <node if="$(arg start_light_controller)"
        pkg="teleop_joy_ctrl"
        type="light_serial_controller_node.py"
        name="light_serial_controller_node"
        output="screen">
    <rosparam command="load" file="$(arg config)" />
  </node>
</launch>
